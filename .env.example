APP_NAME="Овощная база"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=single
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vegetable_base
DB_USERNAME=root
DB_PASSWORD=""
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public
BROADCAST_CONNECTION=log

# SMTP: host, account and application password from your email provider.
# For port 587 use smtp (STARTTLS); for port 465 use smtps.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=""
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Овощная база"

# Two API services: server geocoder and browser JavaScript map.
YANDEX_GEOCODER_API_KEY=
YANDEX_MAPS_API_KEY=

# Use credentials of a test shop for the coursework demonstration.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_TEST_MODE=true
YOOKASSA_VAT_CODE=1
